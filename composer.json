{
    "name": "johnrivera7/filament-mia",
    "description": "A warm editorial theme for Filament v5, for panels that are part of the product. Cream and champagne in the light, espresso in the dark, serif headings and hairline borders. Every surface set by hand rather than derived from an accent colour. Ships pre-compiled: no build step.",
    "keywords": [
        "johnrivera7",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-theme",
        "theme",
        "admin-theme",
        "design-system",
        "dark-mode",
        "tailwindcss"
    ],
    "homepage": "https://github.com/Johnrivera7/filament-mia",
    "support": {
        "issues": "https://github.com/Johnrivera7/filament-mia/issues",
        "source": "https://github.com/Johnrivera7/filament-mia"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "John Rivera",
            "email": "johnriveragonzalez7@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.7",
        "illuminate/contracts": "^11.28|^12.0|^13.0",
        "illuminate/support": "^11.28|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "JohnRivera7\\FilamentMia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnRivera7\\FilamentMia\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test": "phpunit",
        "test:lint": "pint --test",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JohnRivera7\\FilamentMia\\FilamentMiaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
